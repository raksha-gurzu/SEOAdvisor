# Only DeepSeek costs money. Everything else is free (docs/ARCHITECTURE.md §4a).

# LLM: DeepSeek (https://platform.deepseek.com/api_keys) - paid, cents per brief
DEEPSEEK_API_KEY=

# Embeddings + Google-grounded search fallback: Gemini (https://aistudio.google.com/apikey) - free tier
GEMINI_API_KEY=

# Google results: Serper.dev (https://serper.dev) - 2,500 free credits, no card.
# 1 credit per page of 10 results. Required for Keyword Gap (about 120 to 160 credits per analysis).
SERPER_API_KEY=

# Demand data: Bing Webmaster Tools (https://www.bing.com/webmasters) > Settings > API access - free.
# Needs one verified site in Bing Webmaster Tools. Optional for Keyword Gap.
BING_WEBMASTER_API_KEY=

# Site Snapshot link score: Open PageRank (https://openpagerank.keywordseverywhere.com) - free,
# 30,000 domains a month. Sign in with a free Keywords Everywhere key, then create the key on the dashboard.
OPENPAGERANK_API_KEY=

# Site Snapshot speed for real visitors: Chrome UX Report API - free, 150 queries a minute.
# Google Cloud console > enable "Chrome UX Report API" > Credentials > API key (restrict it to that API).
# Optional: without it the speed tile says "not set up".
CRUX_API_KEY=

# Optional paid mode only (data_mode="dataforseo")
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
